{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.sql)",
      "Read(./**/*.sql.gz)",
      "Read(./**/*.sql.zip)",
      "Read(./secrets/**)"
    ]
  }
}
